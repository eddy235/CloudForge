# LOCAL ONLY. Never commit your real secret.
DJANGO_SECRET_KEY=local-only-cloudforge-demo-secret-change-for-real-deployments
NEXUSDESK_DEMO_MODE=true
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Local HTTP only: deployment behind an HTTPS proxy should use true.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_ENABLE_HSTS=false
